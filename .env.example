# 🚂 RAILWAY DEPLOYMENT - Environment Configuration

# Essential environment variables for Railway deployment
PORT=8000
ENVIRONMENT=production

# Database Configuration (if using database)
# DATABASE_URL=postgresql://username:password@host:port/database

# Security Settings
SECRET_KEY=care_catalyst_secret_key_2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ML Model Settings
MODEL_CACHE_SIZE=100
PREDICTION_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Settings
ALLOWED_ORIGINS=*
ALLOW_CREDENTIALS=true

# Feature Flags
ENABLE_WEBSOCKETS=true
ENABLE_ML_PREDICTIONS=true
ENABLE_AYURVEDIC_ANALYSIS=true
ENABLE_COGNITIVE_ASSESSMENT=true